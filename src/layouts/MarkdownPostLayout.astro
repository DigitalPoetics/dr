---
import BaseLayout from "./BaseLayout.astro";
import Figure from "../components/ui/Figure.astro";
import { Image } from "astro:assets";
// import SelectedPosts from "../components/SelectedPosts.astro";
import SelectedPosts from "../components/ui/SelectedPosts.astro";
import SeriesNav from "../components/ui/SeriesNav.astro";
import Dinkus from "../components/ui/Dinkus.astro";
// import Note from "../components/ui/Note.astro";
const { frontmatter } = Astro.props;
---
<BaseLayout 
description={`${frontmatter.description}`}
pageTitle={frontmatter.title}>
  <div class="post-header">
    <!-- <h1 class="title-page" data-pagefind-meta="title">{frontmatter.title}</h1> -->
    <!-- <Dinkus count={3}></Dinkus> -->
    <div class="post-body">
      <Figure>
        <Image 
          slot="image" 
          src={frontmatter.image.src} 
          alt={frontmatter.image.alt} 
          class="responsive-image" 
        />
        <span slot="caption">{frontmatter.image.alt}</span>
      </Figure>
      <Dinkus count={3}></Dinkus>

      <div class="post-meta" data-pagefind-ignore="all">
        <div class="byline">
          <span data-pagefind-meta="author">{frontmatter.author}</span>
          <span class="separator">|</span>
          <span data-pagefind-meta="date">
            {new Date(frontmatter.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
        </div>
        <div class="tags">
          {frontmatter.tags.map((tag: string) => (
            <a class="tag" href={`/posts/${tag}`} target="_blank">{tag}</a>
          ))}
        </div>
      </div>

        <div class="selected-posts">
          <SelectedPosts 
            series={frontmatter.series} 
          />
        </div>

        <Dinkus count={3}></Dinkus>

    </div>
  </div>

  <div class="post-content">
    <slot />
  </div>
  <SeriesNav series={frontmatter.series} currentOrder={frontmatter.seriesOrder} />
  <Dinkus count={3}></Dinkus>

  <!-- modal image -->
  <dialog id="image-lightbox" tabindex="-1">
    <button id="lightbox-close" aria-label="Close image">&times;</button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <script is:inline>
    const dialog = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const closeBtn = document.getElementById('lightbox-close');

    document.querySelectorAll('.post-content img').forEach((img) => {
      img.addEventListener('click', () => {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        dialog.showModal();
      });
    });

    closeBtn.addEventListener('click', () => dialog.close());

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Lock/unlock scroll
    document.querySelectorAll('.post-content img').forEach((img) => {
      img.addEventListener('click', () => {
        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
        dialog.focus();
      });
    });

    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  </script>
</BaseLayout>

<style>

  .post-body {
    margin: 3rem 0 0 0;
  }

  .post-meta {
    display: block;
    /* flex-direction: column;   */
    /* align-items: center; */
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    color: var(--light-text);
    margin: 2rem 0 1.5rem 0;
  }

  html.dark .post-meta {
    color: var(--dark-text);
  }

  .separator {
    color: var(--light-text);
    font-size: var(--font-size-sm);
  }

  html.dark .separator {
    color: var(--dark-text);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
    /* text-underline-offset: 0.15em; */
    color: var(--light-text);
    transition: color 0.2s ease;
  }

  html.dark .tag {
    color: var(--dark-text);
  }

  .tag:hover {
    color: var(--hover-color);
  }

  html.dark .tag:hover {
    color: var(--hover-color);
  }

  /* post styling */
  :global(.post-content figcaption) {
    margin-top: -0.7rem;
  }
  /* :global(.post-content img) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 70vh;
    margin: 0 auto;
    border: var(--image-border);
  } */

  /* list marker styling */
  :global(.post-content ul,
  .post-content ol) {
    padding-left: 1rem;
    /* list-style-position: inside; */
  }

  /* :global(.post-content ul li::marker){
    color: var(--highlight-color);
  } */

  :global(.post-content ul){
    list-style-type: square;
  }

  /* Make post images clickable */
  /* modal image */
  .post-content img {
    cursor: zoom-in;
  }

  #image-lightbox {
    border: none;
    padding: 0;
    margin: auto;
    background: transparent;
    box-sizing: border-box;
    max-width: 100vw;
    max-height: 100vh;
    outline: none;
    /* overflow: hidden; */
  }

  /* #image-lightbox:focus-visible {
    outline: 2px solid var(--highlight-color);
    outline-offset: 2px;
  } */

  #image-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }

  #image-lightbox img {
    display: block;
    max-width: 95vw;
    max-height: 90vh;
    width: auto;
    height: auto;
    border: var(--image-border);
  }

  #lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--light-background);
    font-size: 4rem;
    line-height: var(--line-height-sm);
    cursor: pointer;
    z-index: 10;
    /* outline: none; */
    transition: opacity 0.2s ease;
  }

  /* #lightbox-close:focus-visible {
    outline: 2px solid var(--highlight-color);
    outline-offset: 2px;
  } */

  #lightbox-close:hover {
    opacity: 0.7;
  }

  /* print blog, hide elements */
  @media print {
    @page {
      margin: 1rem 0 1rem 0;
    }

  :global(body) {
    font-family: 'Times New Roman', 'EB Garamond', 'Georgia', serif;
    background: #fff !important;
  }

  /* hide elements */
  :global(.nav-top, .tags, .series-nav, .columns, .no-print) {
    display: none !important;
  }

  /* show these items */
  :global(.selected-posts nav.series-nav) {
    display: block !important;
  }

  /* Show link destinations since they won't be clickable */
  :global(div.post-content a[href]::after) {
    content: "\00a0(" attr(href) ")";
    text-decoration: none;
    display: inline-block;
  }
  /* hide these anchor tags */
  :global(div.post-content sup a::after,
  div.post-content .data-footnote-backref::after) {
    content: none !important;
  }

}

</style>
