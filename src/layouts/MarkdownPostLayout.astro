---
import BaseLayout from "./BaseLayout.astro";
import Figure from "../components/ui/Figure.astro";
import { Image } from "astro:assets";
// import SelectedPosts from "../components/SelectedPosts.astro";
import SelectedPosts from "../components/ui/SelectedPosts.astro";
import Dinkus from "../components/ui/Dinkus.astro";
// import Note from "../components/ui/Note.astro";
const { frontmatter } = Astro.props;
---
<BaseLayout 
description={`${frontmatter.description}`}
pageTitle={frontmatter.title}>
  <div class="post-header">
    <!-- <h1 class="title-page" data-pagefind-meta="title">{frontmatter.title}</h1> -->
    <!-- <Dinkus count={3}></Dinkus> -->
    <div class="post-body">
      <Figure>
        <img 
          slot="image" 
          src={frontmatter.image.url} 
          alt={frontmatter.image.alt} 
          class="responsive-image" 
        />
        <span slot="caption">{frontmatter.image.alt}</span>
      </Figure>
      <div class="post-meta" data-pagefind-ignore="all">
          <span data-pagefind-meta="author">{frontmatter.author}</span>
          <span class="separator">·</span>
          <span data-pagefind-meta="date">
            {new Date(frontmatter.pubDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
          <span class="separator">·</span>
          {frontmatter.tags.map((tag: string) => (
            <a class="tag" href={`/posts/${tag}`} target="_blank">#{tag}</a>
          ))} 
      </div>

        <div class="selected-posts">
          <SelectedPosts 
            frontmatter={frontmatter} 
            series={frontmatter.series} 
          />
        </div>

        <Dinkus count={3}></Dinkus>

    </div>
  </div>

  <div class="post-content">
    <slot />
  </div>
  <Dinkus count={3}></Dinkus>
</BaseLayout>

<style>

  .post-meta {
    display: flex;
    flex-wrap: wrap;  
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-sm);
    color: var(--light-text);
    margin: 0.5rem 0 1.5rem 0;
  }

  html.dark .post-meta {
    color: var(--dark-text);
  }

  .separator {
    color: var(--light-text);
    font-size: var(--font-size-sm);
  }

  html.dark .separator {
    color: var(--dark-text);
  }

  .tag {
    text-decoration: none;
    color: var(--light-text);
    transition: color 0.2s ease;
  }

  html.dark .tag {
    color: var(--dark-text);
  }

  .tag:hover {
    color: var(--hover-color);
  }

  html.dark .tag:hover {
    color: var(--hover-color);
  }



</style>
