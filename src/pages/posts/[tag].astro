---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SelectedPosts from '../../components/ui/SelectedPosts.astro';
import Dinkus from '../../components/ui/Dinkus.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const uniqueTags = [...new Set(allPosts.map(post => post.data.tags).flat().filter(tag => tag))];

  return uniqueTags.map(tag => ({
    params: { tag },
    props: { 
      series: [...new Set(
        allPosts
          .filter(post => post.data.tags?.includes(tag))
          .map(post => post.data.series)
          .filter(s => s)
      )]
    },
  }));
}

const { tag } = Astro.params;
const { series } = Astro.props;
---
<BaseLayout pageTitle={tag}>
  <div data-pagefind-ignore="all">
    <Dinkus count={3} />
    {series.map(s => (
      <SelectedPosts series={s} tag={tag} />
    ))}
    <Dinkus count={3} />
  </div>
</BaseLayout>
