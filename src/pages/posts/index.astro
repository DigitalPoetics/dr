---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Dinkus from '../../components/ui/Dinkus.astro';

const allPosts = await getCollection('posts');
const tags = [...new Set(allPosts.map(post => post.data.tags).flat().filter(tag => tag))].sort();
const pageTittle = "Tag Index";
---
<BaseLayout pageTitle={pageTittle}>
  <!-- <Dinkus count={3} /> -->
  <main data-pagefind-ignore="all">
    <div class="tags">
      {tags.map(tag => (
        <p class="tag"><a href={`/posts/${tag}`} target="_blank">{tag}</a></p>
      ))}
    </div>
  </main>
  <!-- <Dinkus count={3} /> -->
</BaseLayout>



<style>

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
    }

    .tag {
        margin: 0;
        font-size: var(--font-size-base);
        /* padding: 0.5rem 1rem; */
    }

    a {
        display: block;
        padding: 0.5rem 1rem;
        text-decoration: underline;
        text-underline-offset: var(--text-underline-offset);
        color: var(--light-text);
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    a:hover, a:focus {
        color: var(--hover-color);
        background-color: var(--viz-background);
    }

    html.dark a {
        color: var(--dark-text);
    }

    html.dark a:hover, html.dark a:focus {
        color: var(--hover-color);
        background-color: var(--dark-viz-background);
    }

</style>