---
interface Props {
  title: string;
  url: string;
  description: string;
}

const { title, url, description } = Astro.props;
const isActive = Astro.url.pathname === url || Astro.url.pathname === `${url}/`;
const truncated = description.length > 70 ? description.slice(0, 70) + '...' : description;
---
<li>
    <a href={`${url}/`} class={isActive ? 'active' : ''} >
        {title}
        <p>{truncated}</p>
    </a>
</li>

<style>
  li {
    margin: 0;
    /* margin-bottom: 0.5rem; */
    /* cursor: pointer; */
    transition: background-color 0.2s ease;
  }

  li::marker {
    color: var(--light-text);
    transition: color 0.2s ease;
  }

  html.dark li::marker {
    color: var(--dark-text);
  }

  li:has(> a:hover)::marker,
  li:has(> a:focus)::marker,
  li:has(> a.active)::marker {
    color: var(--hover-color);
  }

  li:has(> a.active)::marker {
    color: var(--highlight-color);
  }

  li:has(> a.active) {
    font-weight: bold;
  }

  li:hover {
    background-color: var(--viz-background);
  }

  html.dark li:hover {
    background-color: var(--dark-viz-background);
  }
  a {
    text-decoration: none;
    display: block;
    padding: 0.35rem 0.5rem;
    line-height: var(--line-height-sm);
    transition: color 0.2s ease;
  }

  /* a:hover, a:focus {
    color: var(--hover-color);
  } */

  li:hover a,
  li:focus-within a {
    color: var(--hover-color);
  }

  a.active {
    font-weight: 600;
    color: var(--highlight-color);
  }

  html.dark a.active {
    color: var(--highlight-color);
  }

  p {
    color: var(--light-text-opacity);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-sm);
    margin: 0.1rem 0 0 0;
  }

  html.dark p {
    color: var(--dark-text-opacity);
  }
</style>
