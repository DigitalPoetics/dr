---
// import BaseLayout from "../layouts/BaseLayout.astro";
// import type { ImageMetadata } from 'astro:assets';
export interface Props {
  pageTitle: string;
  description: string;
  imageUrl: string | ImageMetadata;
  imageAlt: string;
  srcPath: string;
}

const { pageTitle, description, imageUrl, imageAlt, srcPath } = Astro.props;
---
<figure class="figure-container">
  <div class="content-wrapper">
    <a href={srcPath} class="text-content" target="_blank">
      <div class="title-container">
        <p class="title">{pageTitle}</p>
        <p class="description">{description}</p>
      </div>
        <div class="image-wrapper">
          <img src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src} alt={imageAlt} class="responsive-image"/>
        </div>
    </a>
    <!-- <div class="text-content">

    </div> -->
    <!-- <div class="image-wrapper">
      <img src={typeof imageUrl === 'string' ? imageUrl : imageUrl.src} alt={imageAlt} class="responsive-image"/>
    </div> -->
    
  </div>
</figure>

<style>
  /* hr {
    margin-bottom: 0.5rem;
  } */
  
  .figure-container {
    margin: 1rem 0 3rem 0;
    /* padding: 0.5rem 0; */
    width: 100%;
    /* border-top: var(--image-border); */
    /* padding: 1rem 0 0 0; */
    /* border-top-width: 1px; */
    /* background-color: var(--viz-background); */
    box-shadow: var(--box-shadow-light);
    padding: 1rem 1rem 1rem 1rem;
    box-sizing: border-box;
  /* border-radius: var(--radius-md); */
  }

  html.dark .figure-container {
    box-shadow: var(--box-shadow-dark);
  }




  .content-wrapper {
    display: flex;
    flex-direction: column;
    /* gap: 1.5rem; */
    /* max-width: 100%; */
    /* padding-top: 0.5rem; */
    position: relative;
  }

  .text-content {
    flex: 1;
    text-decoration: none;
    /* color: inherit; */
    /* display: block; */
    /* min-height: 100%; */
    /* transition: color 0.2s ease; */
  }

  /* .title-container {
    display: block;
    height: 100%;
  } */

  .text-content:hover .title {
    color: var(--hover-color);
    text-decoration-color: currentColor;
  }

  /* .text-content:hover .description {
    color: var(--hover-color);
  } */


  .title {
    margin: 0 0 0.2rem 0;
    /* font-size: 1.3rem; */
    font-weight: 600;
    font-size: var(--font-size-base);
    /* color: var(--highlight-color); */
    color: var(--light-text);
    text-decoration: underline;
    /* line-height: var(--line-height-md); */
    /* color: var(--light-text); */
    /* text-decoration: underline; */
    /* text-decoration-color: transparent; */
    transition: color 0.2s ease;

  }

  .description {
    margin: 0 0 0.5rem 0;
    font-size: var(--font-size-sm);
    font-weight: normal;
    font-style: italic;
    line-height: var(--line-height-sm);
    /* transition: color 0.5s ease; */
    color: var(--light-text);
  }


  html.dark .title {
    /* color: var(--dark-text-color); */
    color: var(--dark-text);
  }

  /* .text-content:hover .title {
    color: var(--highlight-color);
    text-decoration-color: currentColor;
  } */

  html.dark .description {
    color: var(--dark-text);
  }

  .image-wrapper {
    flex: 1;
    margin: 0.4rem 0 0 0;
    /* padding: 1rem 1rem 1rem 1rem; */
    /* box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1); */

    /* overflow: hidden; */
  }

  .responsive-image {
    width: 100%;
    height: 7rem;
    object-fit: cover;
    aspect-ratio: 16 / 10;
    border-radius: 0;
    box-sizing: border-box;

    /* border-radius: var(--radius-md); */

    /* border: none; */
    border: var(--image-border);
    /* box-shadow: 0 0 0.65rem rgba(0, 0, 0, 0.3); */
    /* box-shadow: 0 0 10px var(--light-text-opacity); */
    
  }

  /* Desktop layout - side by side */
  @media (min-width: 636px) {
    .content-wrapper {
      /* display: flex; */
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
      width: 100%;
    }

    /* .text-content {
      flex: 0 0 40%;
      max-width: 40%;
    } */

    /* .title {
      font-size: 1.5rem;
    } */

    /* .description {
      font-size: var(--font-size-sm);
    } */

    .image-wrapper {
      flex: 1;
      /* min-width: 0; */
    }

    .responsive-image {
      width: 100%;
      height: 7rem;
      object-fit: cover;
      aspect-ratio: 16 / 10;
    }
  }

  /* Large desktop */
  /* @media (min-width: 1024px) {
    .content-wrapper {
      gap: 3rem;
    }

    .text-content {
      flex: 0 0 35%;
      max-width: 35%;
    }

    .image-wrapper {
      flex: 1;
      max-width: 65%;
    }

    .title {
      font-size: 2.25rem;
    }
  } */
</style>