---
import DropDown from "./DropDown.astro"
---
<div class="nav-bar">
  <!-- <a href="/home">Home</a> -->
    <DropDown 
        label="Digital Poetics", 
        links={[
            {href: "/digital-archaeology/", text: "Digital Archaeology"},
            {href: "/digital-tropology/", text: "Digital Tropology"},
            {href: "/digital-formalism/", text: "Digital Formalism"},
         ]}, 
        pages={[{ href: "/", text: "Home"}]}
        pagesPosition="above"
    />
    <DropDown 
        label="Sketches", 
        links={[
            {href: "/3d-network/", text: "3D Network"},
            {href: "/tidy-tree/", text: "Tidy Tree"}
         ]},
        pages={[
                {href: "/about/", text: "About"}
        ]}
        pagesPosition="below"
    />
</div>

<!-- {href: "/posts/", text: "Posts"}, -->

<style>

.nav-bar {
  display: none;
  position: fixed;
  top: var(--header-height);
  left: 0;
  width: 100vw;
  height: calc(100vh - var(--header-height)); /* Subtract header height */
  background-color: var(--light-background);
  z-index: 1000;
  padding: 1rem;
  border: var(--image-border);
  box-sizing: border-box;
  overflow-y: auto;
}

html.dark .nav-bar {
  background-color: var(--dark-background);
}

.expanded {
  display: block;
}

/* Hide body scroll when navigation is open - small screens only */
@media screen and (max-width: 635px) {
  body:has(.nav-bar.expanded) {
    overflow: hidden;
  }
}

@media screen and (min-width: 636px) {
  .nav-bar.expanded {
    width: 17rem;
    height: calc(100vh - var(--header-height)); /* Subtract header + footer height */
    left: 0;
    right: auto;
  }
}


</style>

<script>
  // hamburger menu toggle script
  const hamburger = document.querySelector('.hamburger');
  const navBar = document.querySelector('.nav-bar');

  // Toggle nav-bar on hamburger click
  if (hamburger && navBar) {
    hamburger.addEventListener('click', () => {
    navBar.classList.toggle('expanded');
    hamburger.classList.toggle('active');
  });
  }


  // auto-open accordion if current page is inside it
  document.querySelectorAll('details').forEach(details => {
    if (details.querySelector('a.active')) {
      details.open = true;
    }
  });
</script>