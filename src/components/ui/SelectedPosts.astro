---
import { getCollection } from 'astro:content';
import BlogPost from './BlogPost.astro';

interface Props {
  series?: string;
  tag?: string;
}

const { series, tag } = Astro.props;

const allPosts = await getCollection('posts');

const selectedPosts = allPosts
  .filter(post => post.data.series === series)
  .filter(post => tag ? post.data.tags?.includes(tag) : true)
  .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));

// const seriesTitle = selectedPosts.find(p => p.data.seriesOrder === 1)?.data.title ?? series;
const seriesTitle = allPosts.find(p => p.data.series === series && p.data.seriesOrder === 1)?.data.title ?? series;

---
{selectedPosts.length > 0 && (
  <nav class="series-nav" aria-label="Series posts">
    <h3 class="series-title">{seriesTitle}</h3>
    <hr>
    <ol>
      {selectedPosts.map((post: any) =>
        <BlogPost
          url={`/posts/${post.id}`}
          title={post.data.title}
          description={post.data.description}
        />
      )}
    </ol>
  </nav>
)}


<style>
  .series-nav {
    margin: 2rem 0;
    width: 100%;
  }

  .series-title {
    /* font-size: var(--font-size-base); */
    font-weight: 600;
    margin: 0 0 0.3rem 0;
  }

  hr {
    margin: 0 0 0.3rem 0;
  }

  ol {
    margin: 0;
    padding: 0 0 0 1.25rem;
  }
</style>
