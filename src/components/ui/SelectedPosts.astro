---
import BlogPost from './BlogPost.astro';

interface Props {
  series?: string;
}

const { series } = Astro.props;

const allPosts = Object.values(
  import.meta.glob('../../pages/posts/**/*.mdx', { eager: true })
) as any[];

const selectedPosts = allPosts
  .filter(post => post.frontmatter?.series === series)
  .sort((a, b) => (a.frontmatter?.seriesOrder ?? 0) - (b.frontmatter?.seriesOrder ?? 0));

const seriesTitle = selectedPosts.find(p => p.frontmatter?.seriesOrder === 1)?.frontmatter?.title ?? series;
---
{selectedPosts.length > 0 && (
  <nav class="series-nav" aria-label="Series posts">
    <h3 class="series-title">{seriesTitle}</h3>
    <hr>
    <ol>
      {selectedPosts.map((post: any) =>
        <BlogPost
          url={post.url}
          title={post.frontmatter.title}
          description={post.frontmatter.description}
        />
      )}
    </ol>
  </nav>
)}

<style>
  .series-nav {
    margin: 2rem 0;
    width: 100%;
  }

  .series-title {
    /* font-size: var(--font-size-base); */
    font-weight: 600;
    margin: 0 0 0.5rem 0;
  }

  hr {
    margin: 0 0 0.5rem 0;
  }

  ol {
    margin: 0;
    padding: 0 0 0 1.25rem;
  }
</style>
