---
// Props: src, alt, caption (HTML string), width, height
// const { src, alt, caption, width = "100%", height = "auto" } = Astro.props;
---
  <figure>
    <!-- <img src={src} alt={alt} style={`width: ${width}; height: ${height};`} loading="lazy" /> -->
    <slot name="image" />
    <figcaption>
      <!-- <span set:html={caption} /> -->
      <slot name="caption" />
          <!-- {caption ? <span set:html={caption} /> : <slot name="caption" />} -->
    </figcaption>
  </figure>


<style>
  figure {
    margin: 1rem 0 1rem 0;
  }

  /* figure {
    margin: 1rem 0 1rem 0;
    display: table;
  } */


  figcaption {
    margin: 0.3rem 0 0 0;
    font-size: var(--font-size-sm);
    color: var(--light-text);
    text-align: center;
  }

  /* figcaption {
    margin: 0.2rem 0 0 0;
    display: table-caption;
    caption-side: bottom;
    font-size: var(--font-size-sm);
    color: var(--light-text);
    max-width: 90%;
    text-align: left;
  } */

  /* figcaption p {
    margin: 0;
  } */

  html.dark figcaption {
    color: var(--dark-text);
  }

  @media screen and (min-width: 636px) {
    figure {
      margin: 1rem 0 1rem 0;
      /* max-width: 100%; */
    }
    figcaption {
      margin: 0.3rem auto 0 auto;
      width: 80%;
      max-width: 40rem;
      text-align: center;

    }

    /* figcaption {
      display: table-caption;
      caption-side: bottom;
      text-align: left;
      max-width: 75%;
      margin: 0.3rem 0 0 0;
    } */
  }
</style>
