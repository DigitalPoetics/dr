---
const { count = 1 } = Astro.props;
---

<h3 class="dinkus">
  {Array.from({ length: count }, () => (
    <span class="section-break">&#10043;</span>
  ))}
</h3>

<script>
  document.querySelectorAll(".section-break").forEach(el => {
    (el as HTMLElement).style.display = "inline-block";
    (el as HTMLElement).style.animation = "rotate-on-scroll linear";
    (el as HTMLElement).style.animationTimeline = "view()";
    (el as HTMLElement).style.animationRange = "entry 0% exit 20%";
  });
</script>


<style is:global>

    /* section break animation */
/* .section-break {
  display: inline-block;
  animation: rotate-in-view 0.6s ease-in-out both;
  animation-timeline: view();
  animation-range: entry 0% entry 25%;
} */

    .dinkus {
      text-align: center;
    }

    /* .section-break {
        display: inline-block;
        rotate: 0deg;
        animation: rotate-on-scroll ease-in-out;
        animation-timeline: view();
        animation-range: contain 0% contain 100%;
        animation-range: entry -20% exit 20%;
    } */

    .section-break + .section-break {
      margin-left: 0.3em;
    }

    @keyframes rotate-on-scroll {
        from { rotate: 0deg; }
        to { rotate: 360deg; }
    }
</style>